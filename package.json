{
  "name": "justice-for-all-core",
  "version": "0.1.0-dev",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @jfa/web dev",
    "build": "pnpm --filter @jfa/web build",
    "typecheck": "pnpm --filter @jfa/web typecheck && pnpm --filter @jfa/worker typecheck && pnpm --filter @jfa/db typecheck",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm test && pnpm lint && pnpm scan:secrets && pnpm typecheck && pnpm build",
    "db:migrate": "pnpm --filter @jfa/db migrate",
    "lint": "eslint . --max-warnings=0",
    "scan:secrets": "node scripts/scan-secrets.mjs"
  },
  "devDependencies": {
    "eslint": "10.12.0"
  }
}
